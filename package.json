        "air-datepicker": "^3.6.0",
        "alpinejs": "^3.14.9",
        "autoprefixer": "^10.4.21",
        "axios": "^1.6.4",
        "fantasticon": "^2.0.0",
        "fs-extra": "^11.3.2",
        "happy-dom": "^20.11.2",
        "laravel-vite-plugin": "^1.0.0",
        "postcss": "^8.5.3",
        "postcss-import": "^16.1.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^3.4.17",
        "vite": "^5.0.0",
        "vitest": "^4.1.10"
