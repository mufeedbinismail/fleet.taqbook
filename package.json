{
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks')}catch(e){}\"",
        "dev": "vite",
        "build": "vite build",
        "watch": "vite build --watch",
        "icons": "node resources/icons/gen-codepoints.mjs && fantasticon",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"{resources,tests}/**/*.{js,mjs,css}\" \"*.{js,mjs,cjs,json}\"",
        "format:check": "prettier --check \"{resources,tests}/**/*.{js,mjs,css}\" \"*.{js,mjs,cjs,json}\""
    },
    "devDependencies": {
        "@alpinejs/focus": "^3.14.9",
        "@alpinejs/ui": "^3.15.12",
